# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Production values go in .env.production.local (also git-ignored); it overrides .env.local for next build/start.

# Public base URL, used for canonical/hreflang links, Open Graph URLs, emails and Stripe redirects.
# Inlined at build time: rebuild after changing. https:// switches the session cookie to __Host-/Secure.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection (needs the pg_trgm and unaccent extensions; the migration creates them).
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/clubedescontosporto_dev

# Separate database for Playwright (npm run test:e2e). Migrated and seeded with sample data on every run.
E2E_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/clubedescontosporto_test

# Port used by Playwright's production server (npm run test:e2e). Optional.
E2E_PORT=3100

# Seed the fictional sample offers. Defaults to true outside production, false in production.
# Demo accounts (public password) are never seeded in production.
# SEED_SAMPLE_DATA=false

# Stripe (Billing). Without a secret key the plan step says payments are being set up.
# Create the product and prices once with `npm run stripe:setup`.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (/api/stripe/webhook). `stripe listen` prints one for local use.
STRIPE_WEBHOOK_SECRET=
# Optional: a Payment Method Configuration ID (pmc_…) if card + SEPA aren't the account defaults.
STRIPE_PAYMENT_METHOD_CONFIGURATION=

# Transactional email (password reset) via Resend. Without a key, development prints emails to the console.
RESEND_API_KEY=
# Sender; the domain must be verified in Resend.
EMAIL_FROM="Clube Descontos Porto <no-reply@clubedescontosporto.pt>"
